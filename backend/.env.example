DATABASE_URL=postgres://user:password@localhost:5432/musicstream
# provide the CA certificate (PEM text); App Platform provides it as ${db.CA_CERT}.
DATABASE_CA_CERT=
# Set to true to enable PostgreSQL SSL; otherwise it stays disabled.
DATABASE_SSL=

# At least 32 characters in production, e.g. `openssl rand -base64 48`
JWT_SECRET=
PORT=3001
FRONTEND_PORT=5000

# Used by `npm run db:seed` to create the first admin account (password: 12+ characters)
SEED_ADMIN_EMAIL=admin@musicstream.local
SEED_ADMIN_PASSWORD=

# Uploaded media: "local" keeps files in UPLOAD_DIR; "s3" uses an S3-compatible
# bucket such as DigitalOcean Spaces (needed where the disk is wiped on redeploy).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500
# Only for STORAGE_DRIVER=s3
S3_ENDPOINT=https://lon1.digitaloceanspaces.com
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=false

# Proxies in front of the app (1 for App Platform or nginx)
TRUST_PROXY=1
# Header your hosting edge sets to the visitor's IP (App Platform: do-connecting-ip).
# Leave blank unless every request goes through that edge.
CLIENT_IP_HEADER=
# Extra origins allowed to call the API from a browser, comma-separated.
# Not needed when the dashboard is served by this same server.
CORS_ORIGINS=

# Optional: 32 random bytes (base64 or hex) used to encrypt 2FA secrets at rest.
# Defaults to a key derived from JWT_SECRET. Changing either later invalidates existing 2FA setups.
SECRET_ENCRYPTION_KEY=
